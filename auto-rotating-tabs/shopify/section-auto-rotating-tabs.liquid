{% comment %}
  Auto-rotating tabs
  Copy to sections/auto-rotating-tabs.liquid, and copy component/auto-rotating-tabs.css
  and component/auto-rotating-tabs.js to assets/. See README.md for per-theme notes.
  Image focal points come from the image's own focal point in Shopify admin (image_tag
  applies them automatically).
{% endcomment %}

{{ 'auto-rotating-tabs.css' | asset_url | stylesheet_tag }}
<script src="{{ 'auto-rotating-tabs.js' | asset_url }}" defer></script>

<auto-rotating-tabs
  id="AutoRotatingTabs-{{ section.id }}"
  data-interval="{{ section.settings.interval }}"
  data-autoplay="{{ section.settings.autoplay }}"
>
  <div class="art__inner">
    <div class="art__panel">
      {%- if section.settings.heading != blank -%}
        <h2 class="art__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <div class="art__list">
        {%- for block in section.blocks -%}
          <div class="art__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
            <div class="art__media">
              {%- if block.settings.image != blank -%}
                {%- liquid
                  if forloop.first and section.index <= 2
                    assign loading = 'eager'
                  else
                    assign loading = 'lazy'
                  endif
                -%}
                {{
                  block.settings.image
                  | image_url: width: 1400
                  | image_tag:
                    widths: '400, 600, 800, 1000, 1200, 1400',
                    sizes: '(min-width: 750px) 50vw, 100vw',
                    loading: loading,
                    alt: block.settings.image.alt
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <h3 class="art__title">{{ block.settings.title | escape }}</h3>
            <div class="art__body">
              <div><div class="art__desc">{{ block.settings.text }}</div></div>
            </div>
            <span class="art__timer" aria-hidden="true"><i></i></span>
          </div>
        {%- endfor -%}
      </div>
    </div>
    <button type="button" class="art__control" aria-label="Pause" hidden>
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"></svg>
    </button>
  </div>
</auto-rotating-tabs>

{% schema %}
{
  "name": "Auto-rotating tabs",
  "tag": "section",
  "class": "section-auto-rotating-tabs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Key features"
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Seconds per tab",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Rotate automatically",
      "info": "Always off for visitors who have reduced motion turned on.",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Set the focal point on the image itself in Shopify admin."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Describe the feature in a sentence or two.</p>"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Auto-rotating tabs",
      "blocks": [
        { "type": "tab" },
        { "type": "tab" },
        { "type": "tab" }
      ]
    }
  ]
}
{% endschema %}
